#!/bin/bash
#SBATCH --job-name=cvmem_gate
#SBATCH --account=torch_pr_147_courant
#SBATCH --cpus-per-task=16
#SBATCH --mem=24G
#SBATCH --time=06:00:00
#SBATCH --array=0-14
#SBATCH --output=/scratch/ys4907/cv_project_runs/logs/%x_%A_%a.log
# Array over 3 frozen-predictor seeds x 5 parts: 0-2 core; 3-5 and 6-8 FrameMorrow on DINOv2 (as published /
# online variant); 9-14 FrameMorrow on the project's I-JEPA features (optional extra); 15-17 the repo's
# earlier PaFu-KV adaptation as a second PaFu row.
# Trains the literature baselines on the Gate train split and scores every policy on the 192 validation
# episodes. Finished parts are skipped on resubmission, and the compressor training checkpoints every 100
# steps, so a task stopped by the time limit continues where it stopped when the same index is resubmitted.
# Two asset sets:
#   ASSETS=team (default)  the team's frozen predictors, features and scorers; needs gate_team_assets.sbatch.
#                          "Ours" is the published checkpoint, not retrained, and shared policies are checked
#                          row by row against the team's original validation output.
#   ASSETS=rebuild         assets regenerated by gate_assets.sbatch; "ours" is retrained with the frozen code.
# CPU by default. For a GPU: sbatch --gres=gpu:1 --constraint=l40s --export=ALL,DEVICE=cuda gate_baselines.sbatch
set -euo pipefail
SEEDS=(17 29 43)
PARTS=(core fm_dinov2_published fm_dinov2_online fm_ijepa_published fm_ijepa_online pafu_repo)
SEED=${SEEDS[$((SLURM_ARRAY_TASK_ID % 3))]}
PART=${PARTS[$((SLURM_ARRAY_TASK_ID / 3))]}
ROOT=/scratch/ys4907/CV_project
RUNS=/scratch/ys4907/cv_project_runs
SNAP=$RUNS/clean_future_control/src
ASSETS=${ASSETS:-team}
if [ "$ASSETS" = team ]; then
  TEAM=$RUNS/gate_team
  CONFIG=$TEAM/root/resolved_config.json
  DINO=$TEAM/dinov2/features.npz
  OUT=${OUT:-$ROOT/results/memory_baselines/gate_team}
  SOURCE=(--students "$TEAM/extracted/model" --reference "$TEAM/extracted/dataset/validation_results.json"
          --assets-note "team frozen Gate bundle from the private HF org: original predictors, feature cache and scorers")
else
  CONFIG=$RUNS/gate_clean_future/resolved_config.json
  DINO=$RUNS/gate_dinov2/features.npz
  OUT=${OUT:-$ROOT/results/memory_baselines/gate}
  SOURCE=()
fi
DEVICE=${DEVICE:-cpu}
THREADS=${SLURM_CPUS_PER_TASK:-4}
export HF_HOME=/scratch/ys4907/hf_cache
export OMP_NUM_THREADS=$THREADS MKL_NUM_THREADS=$THREADS TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
source /scratch/ys4907/miniconda3/etc/profile.d/conda.sh
conda activate /scratch/ys4907/miniconda3/envs/cvmem
cd "$ROOT"
echo "== host $(hostname) assets $ASSETS seed $SEED part $PART device $DEVICE threads $THREADS $(date -Is)"
[ "$DEVICE" = cpu ] || nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

if [[ "$PART" == fm_dinov2_* ]]; then
  # DINOv2 features are shared by all DINOv2 tasks: the first one to get the lock encodes them.
  mkdir -p "$(dirname "$DINO")"
  (
    flock 9
    python -m experiments.memory_baselines.encode_dinov2 --config "$CONFIG" --snapshot "$SNAP" --out "$DINO" --device "$DEVICE"
  ) 9>"$DINO.lock"
fi

python -m experiments.memory_baselines.gate_run --config "$CONFIG" --snapshot "$SNAP" --out "$OUT" \
  --seed "$SEED" --part "$PART" --device "$DEVICE" --threads "$THREADS" --dinov2 "$DINO" \
  --checkpoints "$RUNS/gate_checkpoints/$ASSETS" ${SOURCE[@]+"${SOURCE[@]}"} ${EXTRA:-}
echo "GATE_BASELINES_DONE seed=$SEED part=$PART $(date -Is)"
